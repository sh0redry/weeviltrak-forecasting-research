# Local mode is credential-free. Copy this file to .env only if desired.
WEEVILTRAK_MODE=local
WEEVILTRAK_CONFIG=app/config/weeviltrak_v2.4_local.yml
WEEVILTRAK_EVENTS=data_exports/v24_redshift_training_events_2026-08-21/v24_canonical_training_event_labels_2023-08-21_to_2026-08-21.csv
WEEVILTRAK_ENGINEERED_FEATURES=data/local/engineered_daily_features.parquet
WEEVILTRAK_LOCAL_STORE=outputs/local/object_store

# Set only on an authorized machine for the original production connectors.
# Never commit .env or real values.
S3_BUCKET_NAME=
AWS_PROFILE=
AWS_REGION=
REDSHIFT_HOST=
REDSHIFT_PORT=5439
REDSHIFT_USER=
REDSHIFT_PASSWORD=
REDSHIFT_DATABASE=
DATABASE_HOST=
DATABASE_PORT=5439
DATABASE_NAME=

